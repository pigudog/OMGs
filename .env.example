# Local-only credentials for the OMGs release runtime. Do not commit real secrets.

# Copy this file to .env and fill the Azure example below for standard runs.
# Local runs may override the omgs_engine evidence-side LLM provider separately.

export AZURE_OPENAI_ENDPOINT=""
export AZURE_OPENAI_API_KEY=""
export AZURE_OPENAI_CHAT_DEPLOYMENT="gpt-5.1"
export AZURE_OPENAI_API_VERSION="2024-10-21"

# Main MDT model defaults used by main.py when --provider/--model are omitted.
export OMGS_PROVIDER="azure"
export OMGS_MODEL="gpt-5.1"

# Optional local fallback when Azure quota is unavailable:
# export OPENROUTER_API_KEY=""
# export OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# export OMGS_PROVIDER="openrouter"
# export OMGS_MODEL="openai/gpt-5.1"

# API trace logging records provider/model parameters, token usage, and latency.
export OMGS_API_TRACE_ENABLED="true"
# If trace logging is enabled, keep raw prompts/responses disabled unless doing
# local debugging with de-identified data.
export OMGS_API_TRACE_RAW_ENABLED="false"
export OMGS_API_TRACE_DB="data/logs/omgs_api_trace.db"
export OMGS_ENGINE_API_TRACE_DB="data/logs/omgs_engine_api_trace.db"

# Optional: force omgs_engine evidence-side LLM calls to a provider/model.
# Leave empty to use omgs_engine source defaults.
# For a local OpenRouter run, set these to:
#   OMGS_ENGINE_PROVIDER="openrouter"
#   OMGS_ENGINE_MODEL="openai/gpt-5.1"
export OMGS_ENGINE_PROVIDER=""
export OMGS_ENGINE_MODEL=""

# Guideline controls used by OMGs evaluation runs.
# The release runtime calls omgs_engine.guidelines through EngineIntegration.
export OMGS_GUIDELINES_DENSE_BACKEND="chroma"
export OMGS_GUIDELINES_RETRIEVAL_MODE="dense_only"
export OMGS_GUIDELINES_FINAL_SELF_CHECK="off"

# Optional verbose CLI diagnostics. Keep disabled for routine runs.
export OMGS_VERBOSE_API_CALLS="false"

# Runtime cache; keep generated reference cache out of tracked data dirs.
export OMGS_REFERENCE_CACHE_DIR="tmp/reference_cache"
